# ---------------------------------------------------------------------------
# Neon Postgres — server-only. This is the one secret that matters: it is what
# keeps the answer key off the client. Never prefix it with NEXT_PUBLIC_.
# Create a project at https://console.neon.tech and copy the POOLED string.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Firebase — sign-in and live group-race rooms. These values are public by
# design (they identify the project, they don't authorise anything); access is
# controlled by firestore.rules. Leave them blank to run without sign-in.
# Firebase console → Project settings → Your apps → Web app → SDK setup.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ---------------------------------------------------------------------------
# Firebase Admin — server-only, and the one new secret. Without it the game
# plays exactly as before (everything a player does is unauthenticated by
# design), but every route that needs a role fails closed with 503 rather than
# trusting the browser.
#
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. Paste the whole JSON on one line, or base64 it if newlines in
# the private key are awkward:  base64 -i service-account.json | pbcopy
#
# This is a real credential with full project access. Never prefix it with
# NEXT_PUBLIC_, and never commit it.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Only needed if the Realtime Database is not the default for the project
# above — used by `npm run db:migrate-access` to read the old access lists.
FIREBASE_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Blob storage for uploaded videos and 3D models — server-only, optional.
# Without it the admin app still accepts YouTube/Vimeo links, direct file
# links and PDB ids; only "a file from my computer" is switched off.
# Vercel dashboard -> Storage -> Blob -> create a store; the token is added to
# the project automatically, and `vercel env pull` brings it here.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# Local development only. Under `next dev`, every request is treated as this
# admin with no sign-in, so /admin can be worked on without a service account.
# Ignored by production builds. Use it with a scratch database branch:
#   node scripts/dev-scratch.mjs --endpoint <branch endpoint id>
# ---------------------------------------------------------------------------
ADMIN_DEV_USER=""
