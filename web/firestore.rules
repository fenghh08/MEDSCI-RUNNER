rules_version = '2';

// Firestore holds the social layer only — sign-in profiles and live group-race
// rooms. Questions and the answer key live in Postgres and are never written
// here, so a reader who gets past these rules still cannot see an answer.
service cloud.firestore {
  match /databases/{database}/documents {

    // A player's own profile: readable by anyone signed in (so a room can show
    // display names), writable only by that player.
    match /players/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // A group-race room. Anyone signed in can read it and join it; only the
    // host can change the room's own settings or delete it.
    match /rooms/{roomId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      // One document per player in the room, holding their live score. A
      // player may only write their own, which stops anyone editing a rival's.
      match /players/{uid} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Nothing else is reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
