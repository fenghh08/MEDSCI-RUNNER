{
  "name": "medsci-runner-web",
  "version": "0.1.0",
  "private": true,
  "description": "Website version of Medsci Runner. Serves ../medsci-runner.html itself, with its content loaded from Neon Postgres and answers graded server-side, so the answer key never reaches the browser.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-anchors.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/check-anchors.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:schema": "node scripts/apply-schema.mjs",
    "db:import": "node scripts/import-game-data.mjs",
    "db:import-atlas": "node scripts/import-atlas-quiz.mjs",
    "db:migrate-access": "node scripts/migrate-access.mjs",
    "db:export": "node scripts/export-game-data.mjs",
    "db:verify": "node scripts/verify-round-trip.mjs",
    "db:publish-offline": "node scripts/export-game-data.mjs && node ../scripts/copy-web-assets.js",
    "check:anchors": "node scripts/check-anchors.mjs",
    "test:validate": "node scripts/test-validate.mjs",
    "test:store": "node scripts/test-store.mjs",
    "test:media": "node scripts/test-media.mjs",
    "check:trace": "node scripts/check-trace.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "@vercel/blob": "^2.9.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^14.5.1",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "jwks-rsa": "3.2.2"
  }
}
